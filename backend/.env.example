# PORT=4000
# TZ=Asia/Jakarta
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/spp_darul_hikmah
# SESSION_SECRET=pikirankutakdapatkumengertikakidikepalakepaladikaki
# SEED_PASSWORD=bendahara123
# BATAS_BAYAR_DI_MUKA_BULAN=12
# BULAN_DIKECUALIKAN=
# COOKIE_SECURE=

# Salin file ini menjadi .env lalu sesuaikan isinya.
PORT=4000
TZ=Asia/Jakarta

# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=mysql://root:password@127.0.0.1:3306/spp_darul_hikmah

# Teks acak panjang (minimal 32 karakter) untuk menandatangani cookie login.
SESSION_SECRET=pikirankutakdapatkumengertikakidikepalakepaladikaki

# Password awal akun bendahara (dipakai oleh `npm run seed`, minimal 8 karakter). WAJIB diganti setelah login.
SEED_PASSWORD=bendahara123

# Batas bayar di muka SPP bulanan dalam kelipatan biaya bulanan (12 = setahun). Kosongkan untuk tanpa batas.
BATAS_BAYAR_DI_MUKA_BULAN=12

# Bulan (1-12) yang tidak ditagih, pisahkan koma. Kosong = ditagih setahun penuh.
BULAN_DIKECUALIKAN=

# Bulan (1-12) dimulainya tahun ajaran; SPP tahunan terbit tiap bulan ini. 7 = Juli.
BULAN_MULAI_TAHUN_AJARAN=7

# Isi true jika diakses lewat HTTPS (wajib untuk server produksi). Kosongkan saat belajar di localhost.
COOKIE_SECURE=
